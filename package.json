{
  "name": "collab-jigsaw-puzzle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:css": "stylelint \"styles/**/*.css\"",
    "lint:js": "eslint \"src/**/*.js\" \"tests/**/*.mjs\"",
    "lint:html": "htmlhint index.html",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:html && npm run lint:contrast && npm run lint:arch",
    "test:yt-key-readonly": "node tests/optional-youtube-key-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "culori": "^4.0.2",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "htmlhint": "^1.9.1",
    "peerjs": "^1.5.5",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
