{
  "name": "collab-jigsaw-puzzle",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:format && npm run lint:css && npm run lint:js && npm run lint:html && npm run lint:contrast && npm run lint:arch && npm run lint:unused && npm run lint:content",
    "lint:format": "prettier --check .",
    "lint:css": "stylelint \"styles/**/*.css\"",
    "lint:js": "eslint \"src/**/*.js\" \"tests/**/*.{js,mjs}\" \"measure/**/*.{js,mjs}\" \"scripts/**/*.mjs\" \"*.config.mjs\"",
    "lint:html": "html-validate index.html && htmlhint index.html",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:unused": "knip",
    "lint:content": "node scripts/sync-content.mjs --check",
    "sync:content": "node scripts/sync-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "measure": "node measure/hosting.mjs && vitest run --config vitest.measure.config.mjs && node measure/report.mjs",
    "format": "prettier --write .",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid",
    "test:yt-key-readonly": "node tests/optional-youtube-key-check.mjs",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "culori": "^4.0.2",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "html-validate": "^9.7.1",
    "htmlhint": "^1.9.1",
    "knip": "^5.88.1",
    "peerjs": "^1.5.5",
    "playwright": "^1.65.1",
    "prettier": "3.10.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.1.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm test"
  }
}
